# Nizam -- real, per-installation credentials. Never committed, matching
# every config file's own docblock ("gitignored in spirit... holds real
# credentials"). config.example.php (the template, no secrets) IS tracked.
config/config.php
config/config.supabase.php
config/*.local.php

# Mutable, per-installation data -- never part of the source tree.
storage/logs/*.log
storage/uploads/*
!storage/uploads/.htaccess
database/backups/*.sql

# Windows packaging build output -- large, machine-specific, regenerated by
# packaging/build.ps1 from the source tree + this machine's own XAMPP
# install. Not source, not meant to be version-controlled.
packaging/stage/
/dist/

# Local scratch/build tooling never meant to ship.
packaging/launcher/*.exe
packaging/assets/nizam.ico
packaging/assets/nizam-256.png
packaging/docs/*.pdf

# OS/editor noise.
.DS_Store
Thumbs.db

# Local Claude Code session-tooling state -- not project source.
.claude/
