{
    "name": "nizam/school-system",
    "description": "Nizam bilingual school management system. Offline releases vendor dependencies; the online image installs the reviewed lock file at build time.",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.1",
        "mpdf/mpdf": "^8.2",
        "phpoffice/phpspreadsheet": "^1.30.8"
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true,
        "preferred-install": "dist",
        "audit": {
            "block-insecure": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
