# Nizam -- re-allows the one folder that's meant to be web-servable (the
# project root's own .htaccess denies everything by default, per §S-4).
Require all granted

# Standard front-controller routing: every request that isn't an existing
# file or directory (vendored CSS/JS, images) goes to index.php, which is
# what turns on Router's plain-string routes (/dashboard, /setup, /login,
# ...). A real file/directory is served directly and never touches PHP --
# the same behavior this app has been developed and tested against via PHP's
# built-in dev server (`php -S ... -t public public/index.php`), whose own
# router-script convention works the same way. Wrapped in <IfModule> so a
# rare Apache build without mod_rewrite fails safe (deny-all still holds)
# instead of a fatal .htaccess parse error.
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^ index.php [QSA,L]
</IfModule>

# sw.js controls its own cache versioning (CACHE_VERSION inside the file) --
# browsers only notice a new service worker exists by re-fetching this exact
# file, and only do that occasionally on their own schedule. If Apache lets
# this file itself be HTTP-cached, a real fix can ship and every returning
# visitor keeps running the old worker (and its old cached app.js/app.css)
# indefinitely, with no error anywhere. Forcing revalidation here is what
# actually makes a service worker update land promptly.
<IfModule mod_headers.c>
    <FilesMatch "^sw\.js$">
        Header set Cache-Control "no-cache, no-store, must-revalidate"
    </FilesMatch>
</IfModule>
