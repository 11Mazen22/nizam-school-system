* text=auto

# Container/CI files must never acquire Windows CRLF line endings.
*.sh text eol=lf
Dockerfile text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.ini text eol=lf
*.conf text eol=lf

# Native Windows packaging scripts are intentionally CRLF.
*.cmd text eol=crlf
*.ps1 text eol=crlf
*.iss text eol=crlf
